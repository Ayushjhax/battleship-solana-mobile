EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WS_URL=ws://192.168.1.x:8080/ws
# Optional. If omitted, the app derives HTTP from EXPO_PUBLIC_WS_URL.
EXPO_PUBLIC_API_URL=http://192.168.1.x:8080
# Privy mobile app client (safe to include in the Expo bundle):
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Use an authenticated/private RPC in production. Defaults to devnet if omitted.
EXPO_PUBLIC_SOLANA_RPC_URL=
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# server only, never in the app bundle:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional override from the Privy dashboard; the SDK otherwise loads app JWKS.
PRIVY_JWT_VERIFICATION_KEY=
# Local Supabase CLI only. Never expose this through an EXPO_PUBLIC_ variable.
SUPABASE_DB_PASSWORD=
# Points treasury: server only. Keep every value out of the Expo bundle.
SOLANA_RPC_URL=
TREASURY_PUBLIC_KEY=
TREASURY_PRIVATE_KEY=
SELL_POINTS_COST=100
SELL_SOL_PAYOUT=0.001
PORT=8080
# Port City flags (server only, default off). Part 10:
# PORT_CITY_CAPTAINS=on   captains in advanced matches
# PORT_CITY_SEAS=on       terrain, the season sea and the Lighthouse
# SEASON_SEA=archipelago  ops override for the ranked sea (else the rotation)
