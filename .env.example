EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WS_URL=ws://192.168.1.x:8080/ws
# Optional. If omitted, the app derives HTTP from EXPO_PUBLIC_WS_URL.
EXPO_PUBLIC_API_URL=http://192.168.1.x:8080
# Dev builds only: log where each tap's time goes (src/net/trace.ts). Leave unset.
EXPO_PUBLIC_TRACE_ACTIONS=
# Privy mobile app client (safe to include in the Expo bundle):
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# The APP's Solana RPC. Compiled into the APK, so use a SEPARATE key restricted to
# this app — never the server's SOLANA_RPC_URL below (Metro refuses to bundle if
# it carries a server secret). Unset, the cluster's public endpoint is used.
EXPO_PUBLIC_SOLANA_APP_RPC_URL=
# mainnet-beta, testnet or devnet (the default when unset).
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# server only, never in the app bundle:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional override from the Privy dashboard; the SDK otherwise loads app JWKS.
PRIVY_JWT_VERIFICATION_KEY=
# Local Supabase CLI only. Never expose this through an EXPO_PUBLIC_ variable.
SUPABASE_DB_PASSWORD=
# Points treasury: server only. Keep every value out of the Expo bundle.
# The treasury's private, authenticated RPC — the app gets its own key above.
SOLANA_RPC_URL=
TREASURY_PUBLIC_KEY=
TREASURY_PRIVATE_KEY=
SELL_POINTS_COST=100
SELL_SOL_PAYOUT=0.001
PORT=8080
# Server: log each action's processing time under its wire seq (server/src/trace.ts).
SEABATTLE_TRACE=
