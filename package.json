    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "roughjs": "^4.6.6",
    "viem": "^2.56.0",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
