{
  "name": "empire-of-bits-seabattle",
  "main": "entrypoint.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:metro": "expo start --dev-client --android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "cd server && npm run dev",
    "lint": "eslint .",
    "eas:apk": "npx eas-cli build --platform android --profile preview",
    "eas:aab": "npx eas-cli build --platform android --profile production",
    "eas:dev": "npx eas-cli build --platform android --profile development",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "assets": "bash scripts/ink-assets.sh",
    "brand": "node scripts/make-brand.mjs"
  },
  "dependencies": {
    "@ethersproject/shims": "^5.8.0",
    "@expo-google-fonts/bitter": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@privy-io/expo": "^0.73.1",
    "@privy-io/expo-native-extensions": "^0.0.12",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.116.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.20",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-qrcode-styled": "^0.3.3",
    "react-native-reanimated": "4.5.1",
