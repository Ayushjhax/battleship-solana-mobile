{
  "expo": {
    "name": "Empire of Bits: Sea Battle",
    "slug": "empire-of-bits-seabattle",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "scheme": "empireofbits",
    "icon": "./assets/images/brand/app-icon.png",
    "android": {
      "package": "com.empireofbits.seabattle",
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/adaptive-icon-fg.png",
        "backgroundColor": "#FBFCFE"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/logo.png",
          "imageWidth": 240,
          "backgroundColor": "#6B4527",
          "resizeMode": "contain"
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5ad1304-4b72-4923-9481-f5fc0bf3f9ee"
      }
    },
    "owner": "ayushjhax"
  }
}
